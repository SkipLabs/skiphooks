# Slashwork API (see https://slashwork.com/developer)
SLASHWORK_GRAPHQL_URL=https://<your-instance>.slashwork.com/api/graphql

# Slashwork auth tokens are stored in the database (auth_tokens table), not
# read from the environment at runtime. Create them from the /slashwork admin
# page or POST /api/admin/tokens. The variables below are only read by the
# seed scripts (bun run db:seed, bun scripts/seed-calendar.ts).
SLASHWORK_AUTH_TOKEN_SKIPPER=
SLASHWORK_AUTH_TOKEN_SKJS=
SLASHWORK_AUTH_TOKEN_SKIP=
SLASHWORK_AUTH_TOKEN_GOOGLE_CALENDAR=

# GitHub webhook signature secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# GitHub API (optional — enables repo activity in summaries and digest)
# GITHUB_OWNER: org or user whose repos are discovered automatically via the API
# GITHUB_TOKEN: fine-grained token with read-only Contents + Metadata access
GITHUB_OWNER=skiplabs
GITHUB_TOKEN=

# Google Calendar reminders (optional — omit to disable)
# Service account JSON key (paste the full JSON content). Per-user
# calendar → group mapping lives in the calendar_users table.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}

# Anthropic (AI summaries and weekly digest)
ANTHROPIC_API_KEY=

# Database (PostgreSQL — provided by Clever Cloud as POSTGRESQL_ADDON_URI)
POSTGRESQL_ADDON_URI=

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Ports
PORT=8080
# Skip reactive engine (real-time streaming from DB to UI)
SKIP_STREAMING_PORT=8079
SKIP_CONTROL_PORT=8078
