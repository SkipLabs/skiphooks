{
  "name": "skiphooks",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "rm -rf .next && next build",
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-8080}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "test": "bash scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "install-hooks": "cp scripts/pre-commit.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/setup-db.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@clerk/nextjs": "7.9.4",
    "@skip-adapter/postgres": "0.0.19",
    "@skipruntime/core": "0.0.19",
    "@skipruntime/helpers": "0.0.19",
    "@skipruntime/server": "0.0.19",
    "@skipruntime/wasm": "0.0.19",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "patchedDependencies": {
    "@skip-adapter/postgres@0.0.19": "patches/@skip-adapter%2Fpostgres@0.0.19.patch"
  },
  "overrides": {
    "postcss": "8.5.28",
    "nanoid": "3.3.19",
    "sharp": "0.35.4",
    "path-to-regexp": "0.1.13",
    "qs": "6.16.0",
    "body-parser": "1.20.8"
  }
}
